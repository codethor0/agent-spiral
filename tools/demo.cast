[8.804867, "o", "\r  pull: \u001b[36m[q]\u001b[0m\u001b[33m~\u001b[0m\u001b[33m~\u001b[0m\u001b[33m~\u001b[0m\u001b[33m~\u001b[0m\u001b[33m~\u001b[0m\u001b[33m~\u001b[0m\u001b[33m~\u001b[0m\u001b[33m~\u001b[0m\u001b[33m~\u001b[0m\u001b[33m~\u001b[0m\u001b[33m~\u001b[0m\u001b[35m[q̄]\u001b[0m  E=60 GeV … pulling     "]
