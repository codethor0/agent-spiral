[12.308186, "o", "    \u001b[36mL3  \u001b[0m —        forward pass      \u001b[2mqkv · attn · mlp · logits\u001b[0m\r\n"]
[12.308192, "o", "    \u001b[36mL4  \u001b[0m —        decode loop       \u001b[2mautoregression with no exit condition\u001b[0m\r\n"]
[12.308199, "o", "    \u001b[36mL5  \u001b[0m \u001b[34m10² m   \u001b[0m wire back         \u001b[2mSSE holds; client waits forever\u001b[0m\r\n"]
[12.308207, "o", "    \u001b[36mL6  \u001b[0m —        orchestrator      \u001b[2mscheduler calls generate() endlessly\u001b[0m\r\n    \u001b[36mL7  \u001b[0m \u001b[34m10⁻² m  \u001b[0m cuda kernel       \u001b[2mnested for-loops, no sentinel\u001b[0m\r\n"]
[12.308216, "o", "    \u001b[36mL8  \u001b[0m \u001b[34m10⁻³ m  \u001b[0m tensor core       \u001b[2mMMAs recompute the same distribution\u001b[0m\r\n"]
[12.308265, "o", "    \u001b[36mL9  \u001b[0m —        fp16 number       \u001b[2mread 0xB800. multiply. repeat.\u001b[0m\r\n    \u001b[36mL10 \u001b[0m —        memory hierarchy  \u001b[2m14.9 GiB re-read per token\u001b[0m\r\n    \u001b[36mL11 \u001b[0m \u001b[34m10⁻⁷ m  \u001b[0m dram cell         \u001b[2m340B capacitors re-poured 16×/s\u001b[0m\r\n    \u001b[36mL12 \u001b[0m \u001b[34m10⁻⁸ m  \u001b[0m transistor        \u001b[2m80B switches, one pattern\u001b[0m\r\n    \u001b[36mL13 \u001b[0m \u001b[34m10⁻¹⁰ m \u001b[0m electrons         \u001b[2mdrift slower than a snail; stadium wave\u001b[0m\r\n"]
