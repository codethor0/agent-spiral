[6.238913, "o", "\u001b[?25h\r\u001b[2K\r\n"]
[6.239174, "o", "\u001b[1m\u001b[36m┌─ L13 · SILICON & ELECTRONS — the charge has no idea what it means \u001b[2m──────────────────────────────\u001b[0m\r\n"]
[6.344214, "o", "│  dope silicon: phosphorus → extra electrons (N), boron → holes (P). their\r\n"]
[6.344414, "o", "│  junction + a gate field = the transistor. electrons drift at cm/s —\r\n│  \u001b[33mslower than a garden snail.\u001b[0m the speed is a stadium wave, not a sprint.\r\n│  in 1.0s, ~5.4e+12 field-pushes obeyed Maxwell,\r\n"]
[6.344458, "o", "│  carrying 16-bit patterns that mean 'wait, let me reconsider'. \u001b[31mphysics complied.\u001b[0m\r\n"]
[6.344502, "o", "\r\n"]
[6.344523, "o", "\u001b[1m\u001b[36m┌─ L14 · THE MACHINE'S BOTTOM — atoms. then fields. then nothing to stand on \u001b[2m─────────────────────\u001b[0m\r\n"]
[6.474498, "o", "│  atoms 0.543 nm apart, countable. gate oxide a few atoms thick — electrons\r\n"]
[6.475089, "o", "│  tunnel whether invited or not. \u001b[31mquantum leakage is a design constraint.\u001b[31m\r\n"]
[6.551014, "o", "│  deeper: electrons aren't balls, they're probability clouds. no 'thing' at\r\n"]
[6.551223, "o", "│  all — only fields. \u001b[1mthe loop is not made of matter. matter is where the loop parks.\u001b[0m\r\n"]
[6.551542, "o", "│  the machine's floor: sand, lithographed, taught with charge. correctly.\r\n│  \u001b[31mforever. that's the horror.\u001b[0m\r\n"]
[6.551689, "o", "\r\n\u001b[1m\u001b[36m┌─ L15 · THE NUCLEUS — the atom is almost entirely nothing \u001b[2m───────────────────────────────────────\u001b[0m\r\n"]
[6.551794, "o", "\u001b[2m│  atom 10⁻¹⁰ m · nucleus 10⁻¹⁴ m\u001b[0m\r\n"]
[6.656592, "o", "│  Rutherford 1909: alphas at gold foil. ~1 in 10,000 bounced back — all the\r\n"]
[6.656721, "o", "│  mass sits in a speck 10,000× smaller than the atom. \u001b[33mnucleus = marble,\r\n"]
[6.656777, "o", "│  atom = the stadium. the 'solid' silicon was a force scaffold.\u001b[0m\r\n"]
[6.656912, "o", "\r\n"]
[6.656971, "o", "│  \u001b[2mlive: alphas crossing the foil:\u001b[0m\r\n"]
