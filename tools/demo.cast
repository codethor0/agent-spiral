[4.812985, "o", "\r\u001b[2K│  \u001b[33mthe die produced ~16.1 GFLOP of flawless, useless math.\u001b[0m\r\n"]
[4.813189, "o", "\u001b[2m│  nothing above the MMA knows it's wasted. nothing below knows there was a question.\u001b[0m\r\n"]
[4.813211, "o", "\r\n"]
