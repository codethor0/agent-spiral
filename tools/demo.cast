[3.83564, "o", "\r\u001b[2K│  \u001b[33mthe die produced ~15.2 GFLOP of flawless, useless math.\u001b[0m\r\n"]
[3.835746, "o", "\u001b[2m│  nothing above the MMA knows it's wasted. nothing below knows there was a question.\u001b[0m\r\n"]
[3.83576, "o", "\r\n"]
[3.835768, "o", "\u001b[1m\u001b[36m┌─ L9 · THE NUMBER — one weight, literally \u001b[2m───────────────────────────────────────────────────────\u001b[0m\r\n"]
[3.835777, "o", "\u001b[2m│  fp16 · zoom: 16 bits\u001b[0m\r\n"]
[3.937716, "o", "│  w = −0.5 → \u001b[36m1 01110 0000000000\u001b[0m = 0xB800 \u001b[2m(sign · exp 2⁻¹ · mantissa 1.0)\u001b[0m\r\n"]
[3.937766, "o", "│  a multiply: XOR signs, add exponents, multiply mantissas — ~10,000\r\n│  transistors, one clock. \u001b[33mread once per token, forever:\u001b[0m\r\n"]
[3.937781, "o", "│  \u001b[31mread 0xB800. multiply. repeat.\u001b[0m\r\n\r\n"]
[3.937799, "o", "\u001b[1m\u001b[36m┌─ L10 · MEMORY HIERARCHY — the speed ladder the loop rides \u001b[2m──────────────────────────────────────\u001b[0m\r\n"]
[4.04211, "o", "│  \u001b[36mregister   \u001b[0m   ~0.5 ns \u001b[2mHMMA fragments\u001b[0m\r\n"]
[4.042199, "o", "│  \u001b[36mSMEM       \u001b[0m    ~15 ns \u001b[2mGEMM tiles\u001b[0m\r\n│  \u001b[36mL2         \u001b[0m   ~200 ns \u001b[2mdie-wide 50 MB\u001b[0m\r\n"]
