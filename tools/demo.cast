[6.157015, "o", "\u001b[1m\u001b[36m┌─ L13 · SILICON & ELECTRONS — the charge has no idea what it means \u001b[2m──────────────────────────────\u001b[0m\r\n"]
[6.262116, "o", "│  dope silicon: phosphorus → extra electrons (N), boron → holes (P). their\r\n"]
[6.262181, "o", "│  junction + a gate field = the transistor. electrons drift at cm/s —\r\n│  \u001b[33mslower than a garden snail.\u001b[0m the speed is a stadium wave, not a sprint.\r\n│  in 1.0s, ~5.4e+12 field-pushes obeyed Maxwell,\r\n"]
[6.262196, "o", "│  carrying 16-bit patterns that mean 'wait, let me reconsider'. \u001b[31mphysics complied.\u001b[0m\r\n"]
