[13.329694, "o", "    \u001b[36mL2  \u001b[0m \u001b[34m10⁻¹ m  \u001b[0m gpu               \u001b[2mweights + KV cache resident in VRAM\u001b[0m\r\n    \u001b[36mL3  \u001b[0m —        forward pass      \u001b[2mqkv · attn · mlp · logits\u001b[0m\r\n    \u001b[36mL4  \u001b[0m —        decode loop       \u001b[2mautoregression with no exit condition\u001b[0m\r\n    \u001b[36mL5  \u001b[0m \u001b[34m10² m   \u001b[0m wire back         \u001b[2mSSE holds; client waits forever\u001b[0m\r\n    \u001b[36mL6  \u001b[0m —        orchestrator      \u001b[2mscheduler calls generate() endlessly\u001b[0m\r\n    \u001b[36mL7  \u001b[0m \u001b[34m10⁻² m  \u001b[0m cuda kernel       \u001b[2mnested for-loops, no sentinel\u001b[0m\r\n    \u001b[36mL8  \u001b[0m \u001b[34m10⁻³ m  \u001b[0m tensor core       \u001b[2mMMAs recompute the same distribution\u001b[0m\r\n"]
