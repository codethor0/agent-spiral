[3.768685, "o", "\r\u001b[2K"]
[3.768808, "o", "│  \u001b[33mthe die produced ~16.2 GFLOP of flawless, useless math.\u001b[0m\r\n"]
[3.769122, "o", "\u001b[2m│  nothing above the MMA knows it's wasted. nothing below knows there was a question.\u001b[0m\r\n"]
[3.769248, "o", "\r\n"]
[3.769433, "o", "\u001b[1m\u001b[36m┌─ L9 · THE NUMBER — one weight, literally \u001b[2m───────────────────────────────────────────────────────\u001b[0m\r\n"]
