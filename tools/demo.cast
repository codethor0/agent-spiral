[0.89389, "o", "\r\n\u001b[1m  🌀 THE SPIRAL \u001b[2mv1.1.4 — the complete descent · L0 → L22 · maximum depth\u001b[0m\r\n"]
[0.893992, "o", "  question: \u001b[36m\"why did production go down last night?\"\u001b[0m  \u001b[2m(Ctrl+C any time → final report)\u001b[0m\r\n"]
[0.894023, "o", "\r\n"]
[0.894039, "o", "\u001b[1m\u001b[36m┌─ L0 · THE WIRE — where your words physically go \u001b[2m────────────────────────────────────────────────\u001b[0m\r\n"]
[0.996539, "o", "│  you press Enter → POST /v1/chat/completions, HTTP/2, TLS 1.3.\r\n"]
[0.996634, "o", "│  ~1.2 KB in TCP segments → NIC → fiber → load balancer → scheduler queue.\r\n"]
[1.076692, "o", "│  \u001b[32m✔ ~38 ms. the question is inside a datacenter.\u001b[0m \u001b[31mnobody armed the 'decides it's done' part.\u001b[0m\r\n"]
[1.076808, "o", "\r\n"]
[1.076856, "o", "\u001b[1m\u001b[36m┌─ L1 · TOKENIZER — text stops being text \u001b[2m────────────────────────────────────────────────────────\u001b[0m\r\n"]
[1.076946, "o", "│  tokens: \u001b[36m'why'\u001b[0m \u001b[36m'did'\u001b[0m \u001b[36m'production'\u001b[0m \u001b[36m'go'\u001b[0m \u001b[36m'down'\u001b[0m \u001b[36m'last'\u001b[0m \u001b[36m'night'\u001b[0m \u001b[36m'?'\u001b[0m\r\n"]
[1.076982, "o", "│  ids   : \u001b[33m[3808, 62627, 19605, 13604, 101318, 17690, 6828, 63]\u001b[0m\r\n│  8 tokens in. every token out costs real compute.\r\n\r\n\u001b[1m\u001b[36m┌─ L2 · GPU — the machine your question now lives in \u001b[2m─────────────────────────────────────────────\u001b[0m\r\n"]
[1.077004, "o", "\u001b[2m│  H100 · 80 GB HBM3 · ~700 W · 3.35 TB/s\u001b[0m\r\n"]
[1.182039, "o", "│  weights: \u001b[35m8B × 2 bytes\u001b[0m = 14.9 GiB resident, \u001b[2mloaded once at boot. never reload.\u001b[0m\r\n"]
[1.182192, "o", "│  KV cache pool: \u001b[33m24.4 GiB\u001b[0m \u001b[2m(128 KiB/token × 200k)\u001b[0m — the context window IS spare VRAM.\r\n"]
[1.182297, "o", "│  \u001b[32m✔ model resident. KV zeroed. ready.\u001b[0m\r\n\r\n\u001b[1m\u001b[36m┌─ L3 · ONE DECODE STEP — what 'thinking' is physically \u001b[2m──────────────────────────────────────────\u001b[0m\r\n"]
[1.182327, "o", "\u001b[2m│  ×32 layers per token\u001b[0m\r\n"]
[1.287377, "o", "│    q,k,v = h·W_qkv → attn = softmax(q·kᵀ/√d)·v ← reads EVERY past k,v\r\n"]
[1.287434, "o", "│    MLP → logits = h·W_unembed [4096→128256] → softmax(T=0.7) → 1 token → repeat\r\n"]
[1.287453, "o", "│  \u001b[33m≈16 GFLOP/token + an attention tax that grows with context.\u001b[0m \u001b[2mthere is only this loop.\u001b[0m\r\n"]
[1.287463, "o", "\r\n"]
[1.287471, "o", "\u001b[1m\u001b[36m┌─ L4 · DECODE LOOP — prefill done. now it generates… forever \u001b[2m────────────────────────────────────\u001b[0m\r\n"]
