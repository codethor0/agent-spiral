[3.708597, "o", "\r\u001b[2K│  \u001b[33mthe die produced ~16.2 GFLOP of flawless, useless math.\u001b[0m\r\n"]
[3.70872, "o", "\u001b[2m│  nothing above the MMA knows it's wasted. nothing below knows there was a question.\u001b[0m\r\n"]
